{
  "name": "stockpilot",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev apps/web",
    "build": "next build apps/web --webpack",
    "lint": "tsc --noEmit",
    "test": "node --test tests/unit/*.test.mjs",
    "contracts:lint": "for file in contracts/genlayer/*.py; do uvx --python 3.12 --from genvm-linter genvm-lint check \"$file\" || exit 1; done",
    "base:test": "forge test"
    ,"genlayer:deploy": "node scripts/deploy-genlayer.mjs"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1",
    "genlayer-js": "^1.1.8",
    "mongodb": "^6.21.0",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "viem": "^2.55.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5"
  }
}
